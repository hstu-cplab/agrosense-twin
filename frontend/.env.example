# The app ships with a working demo Firebase project baked into src/firebase.ts,
# so it builds and deploys with NO configuration.
#
# Only set these if you want to point AgroSense at your OWN Firebase project.
# Copy this file to `.env` for local dev, or add the vars in
# Vercel → Project → Settings → Environment Variables.
#
# After switching projects: enable Email/Password auth, create a Firestore
# database, deploy `../firestore.rules`, and add your deployed domain under
# Firebase Auth → Settings → Authorized domains.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
